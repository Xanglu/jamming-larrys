{
  "manifest_version": 3,
  "name": "Jamming Larrys",
  "version": "1.3.2",
  "description": "Keep YouTube or Radio Garden playback in sync with a friend. One person hosts, everyone follows. No accounts, no server.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "alarms", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://radio.garden/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jamming Larrys",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://radio.garden/*"],
      "js": ["rg-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://radio.garden/*"],
      "js": ["content-radio.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/mascot.webp"],
      "matches": ["https://www.youtube.com/*", "https://radio.garden/*"]
    }
  ]
}
